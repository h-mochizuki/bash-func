}
alias str.c.purple="str.color.purple"

str.rect() (
  # 四角形を描画します
  # param1 横幅
  # param2 高さ
  # stdout 四角形
  local w=${1:-20}
  [[ w -le 1 ]] && {
    str.times "-\n" ${2:-1}
    exit
  }
  local h=${2:-$(( w / 2 + 1))}
  local w2=$(( w -2 ))
  cat <<<$(str.fill -n $w '-'; [[ ${h} -ge 2 ]] && str.times "|$(str.fill -n ${w2})|\n" $(( h -2 )); str.fill -n $w '-')
)
