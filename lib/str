  # 入力を灰字にします
  # param1+ 灰字にしたい文字列
  # stdout 灰字にした文字列
  echo -e "\033[30m${@}\033[0m"
}
alias str.c.gray="str.color.gray"

str.color.red() {
  # 入力を赤字にします
  # param1+ 赤字にしたい文字列
  # stdout 赤字にした文字列
