#!/bin/bash
# =====================================
#            文字列関数定義
# =====================================
base="$(cd $(dirname ${BASH_SOURCE:-$0}); pwd)"
source "${base}/num"

# ----------------
#     関数定義
# ----------------
str.indexOf() {
  # 検索対象文字列が入力文字列（もしくはストリーミング）の何文字目にあたるかを返します
  # 入力文字列（param2）が指定された場合は、入力ストリームより優先します
  # input-stream 入力ストリーム
  # param1 検索対象文字列
  # param2 入力文字列
  # stdout 検索対象文字列が何文字目にあたるか
  # returnCd 0:文字列が見つかった 1:文字列が見つからなかった
  local target="${1-}"
  local idx
  if [[ "$#" -ge 2 ]];then
    idx=$(awk -v t="${target}" -v l="${2}" 'BEGIN{ print index(l, t)-1 }')
  else
    idx=$(str.stream | awk -v t="${target}" '{ print index($0, t)-1 }')
  fi
  echo "$idx"
  [[ ! "$idx" == "-1" ]]
}

str.contains() {
  # 検索対象文字列が入力文字列（もしくはストリーミング）に含まれるかを返します
  # 入力文字列（param2）が指定された場合は、入力ストリームより優先します
  # input-stream 入力ストリーム
  # param1 検索対象文字列
  # param2 入力文字列
  # returnCd 0:文字列が含まれている 1:文字列が含まれていない
  local target="${1-}"
  local index
  if [[ "$#" -ge 2 ]];then
    index=$(awk -v t="${target}" -v l="${2}" 'BEGIN{ print index(l, t) }')
  else
    index=$(str.stream | awk -v t="${target}" '{ print index($0, t) }')
  fi
  [[ ! "$index" == "0" ]]
}

str.match() {
  # パターンが入力文字列にマッチするかを判定し、判定結果を返します
  # param1 パターン
  # param2 入力文字列
  # stdout マッチした文字列を格納した配列
  # returnCd 0:文字列が含まれている 1:文字列が含まれていない
  if [[ "$#" -ge 2 ]];then
    local regex="$1";shift
    local line="$1"
    if [[ "$line" =~ $regex ]];then
      echo "${BASH_REMATCH[@]}"
      return 0
    fi
  fi
  return 1
}

__str.stdin() {
  # 入力ストリームがパイプかファイルの場合のみ、その内容を返します
  # 端末や /dev/null などは読みません
  # input-stream 入力ストリーム
  # stdout 入力ストリームの内容
  # returnCd 0:1文字以上出力した 1:出力しなかった
  local c
  [[ -p /dev/stdin || -f /dev/stdin ]] || return 1
  # 1文字目を読めた場合のみ、入力ストリームを流す
  IFS= read -r -d '' -n 1 c || return 1
  printf '%s' "${c}"
  cat -
}

str.stream() {
  # 入力引数と入力ストリームを、この順にストリームとして返します
  # 入力ストリームはパイプかファイルの場合のみ読みます（端末や /dev/null は読みません）
  # どちらも無い場合（入力ストリームが空の場合を含む）は空行を返します
  # opt: n 入力ストリームを読まない（while read ループ内などで使用）
  # opt: l 入力引数を1引数1行で出力する（未指定時は空白区切りの1行）
  # input-stream 入力ストリーム
  # param1+ 入力引数
  # stdout ストリーム
  # ----
  # オプションは先頭に指定した -n / -l のみ解釈します（他の - 始まりの文字列は入力引数として扱います）
  # usage)
  # echo 'body' | str.stream 'header'   # => header / body
  # str.stream -n 'only args'
  local noStdin='' perLine=''
  while [[ "$#" -gt 0 ]];do
    case "$1" in
      -n) noStdin='true';shift;;
      -l) perLine='true';shift;;
      *) break;;
    esac
  done
  if [[ "$#" -gt 0 ]];then
    if [[ "${perLine}" ]];then
      printf '%s\n' "$@"
    else
      printf '%s\n' "$*"
    fi
  fi
  if [[ -z "${noStdin}" ]] && __str.stdin;then
    return 0
  fi
  [[ "$#" -eq 0 ]] && echo
  return 0
}

str.toLower() {
  # 入力文字列と入力ストリームを小文字に変換します
  # 入力文字列の後に、入力ストリームを処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1+ 文字列
  # stdout 小文字に変換した文字列
  str.stream "$@" | tr '[:upper:]' '[:lower:]'
}

str.toUpper() {
  # 入力文字列と入力ストリームを大文字に変換します
  # 入力文字列の後に、入力ストリームを処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1+ 文字列
  # stdout 大文字に変換した文字列
  str.stream "$@" | tr '[:lower:]' '[:upper:]'
}

str.toLf() {
  # 改行コードを CRLF -> LF 変換します
  # 入力文字列の後に、入力ストリームを処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1+ 文字列
  # stdout 改行コードを LF に変換した文字列
  str.stream "$@" | tr -d \\r
}

str.toCrLf() {
  # 改行コードを LF -> CRLF 変換します
  # 入力文字列の後に、入力ストリームを処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1+ 文字列
  # stdout 改行コードを CRLF に変換した文字列
  str.stream "$@" | str.toLf | sed 's/$/\r/g'
}

str.charset() {
  # 文字コードを返します
  # param1+ ファイル名
  # stdout 文字コード
  local p c
  for p in "$@";do
    c=$(file -i "${p}" | sed -e 's/^.*=//' | str.toUpper)
    if [[ "${c}" ==  'UNKNOWN-8BIT' ]];then
      echo -e "SHIFT-JIS\t${p}"
    else
      echo -e "${c}\t${p}"
    fi
  done
}

str.convert() {
  # 文字コード及び改行コードを変更します
  # opt: f 変更元文字コード（デフォルト: str.charset の結果）
  # opt: t 変更後文字コード（デフォルト: UTF-8）
  # opt: l 変更後改行コード（LF | CRLF, デフォルト: LF）
  # param1+ ファイル名
  # stdout 変換後のファイル内容
  local OPTIND
  local p
  local from
  local to='UTF-8'
  local lineseparator='LF'
  while getopts f:t:l: OPT
  do
    case $OPT in
      f) from="$(str.toUpper -n $OPTARG)"
      ;;
      t) to="$(str.toUpper -n $OPTARG)"
      ;;
      l) lineseparator="$(str.toUpper -n $OPTARG)"
      ;;
    esac
  done
  shift $((OPTIND - 1))

  for p in "$@";do
    if [ -z "${from+x}" ];then
      from=$(str.charset "${p}" | awk '{ print $1 }')
    fi
    if [ "${lineseparator}" == "LF" ];then
      iconv -f "${from}" -t "${to}" "${p}" | str.toLf
    else
      iconv -f "${from}" -t "${to}" "${p}" | str.toCrLf
    fi
  done
}

str.isInteger() {
  # 入力文字列が整数かどうかを返します
  # param1 入力文字列
  # returnCd 0:整数 1:整数ではない
  num.isInteger "$1"
}

str.isNumber() {
  # 小数の場合も考慮し、入力文字列が数値かどうかを返します
  # param1 入力文字列
  # returnCd 0:数値 1:数値ではない
  [[ "$#" -eq 0 ]] && return 1
  num.isInteger "${1/./}"
}

str.times() {
  # 文字列を指定回数繰り返します
  # param1 文字列
  # param2 指定回数（デフォルト: 1回）
  # stdout 指定回数繰り返された文字列
  printf "%*s" ${2:-1} | sed -e "s/ /${1:-}/g"
}

str.evalstr() {
  # 入力内容に含まれる環境変数やスクリプトを評価した文字列を返します
  # 入力文字列の後に、入力ストリームを処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1 対象文字列
  # stdout 環境変数やスクリプトを評価した文字列
  str.stream "$@" | eval "echo -e \"$(cat)\""
}

str.evalfile() {
  # ファイルに含まれる環境変数やスクリプトを評価した文字列を返します
  # ファイルが指定された場合は、入力ストリームより優先します
  # input-stream 入力ストリーム
  # param1 ファイルパス（- は入力ストリーム）
  # stdout 環境変数やスクリプトを評価した文字列
  if [[ "$#" -ne 0 ]];then
    cat "$1"
  elif [[ ! -t 0 ]];then
    cat -
  fi | eval "echo -e \"$(cat)\""
}

str.initial() {
  # 頭文字を返します
  # 対象文字列の後に、入力ストリームを1行ずつ処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1+ 対象文字列
  # stdout 頭文字
  str.stream -l "$@" | sed -e 's/^\(.\).*$/\1/'
}

str.trim() {
  # 前後の空白を除去します
  # 対象文字列の後に、入力ストリームを1行ずつ処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1+ 対象文字列
  # stdout 前後の空白を除去した文字列
  str.stream -l "$@" | sed -e 's/^\s*//' -e 's/\s*$//'
}

str.take() {
  # 指定文字数分を切り出します
  # 対象文字列の後に、入力ストリームを処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1 指定文字数（負数で末尾から）
  # param2+ 対象文字列
  # stdout 切り出した文字列（指定文字数が不正な場合は対象文字列そのまま）
  # returnCd 0:正常 1:指定文字数が不正
  local no=()
  [[ "${1-}" == "-n" ]] && { no=(-n); shift; }
  str.isInteger "$1" >/dev/null 2>&1
  [[ "$?" -ne 0 ]] && str.stream "${no[@]}" "$@" && return 1
  local justified="^\(.\{${1#-}\}\).*"
  [[ "${1%%[0-9]*}" == "-" ]] && justified=".*\(.\{${1#-}\}\)$"
  shift
  str.stream "${no[@]}" "$@" | sed -e "s/${justified}/\1/"
}

str.fill() {
  # 指定文字数まで指定文字で満たします
  # 対象文字列の後に、入力ストリームを処理します
  # opt: n 入力ストリームを読まない
  # input-stream 入力ストリーム
  # param1 指定文字数（負数で右寄せ）
  # param2 指定文字
  # param3+ 対象文字列
  # stdout 指定文字で満たした文字列
  # returnCd 0:正常 1:パラメータ不正
  local no=()
  [[ "${1-}" == "-n" ]] && { no=(-n); shift; }
  [[ "$#" -eq 0 ]] && return 1
  str.isInteger "$1" ||  return 1
  local justified="left"
  [[ "${1%%[0-9]*}" == "-" ]] && justified="right"
  local max="${1#-}"; shift
  local pad="${1:- }"; shift
  local full=$( str.times "${pad}" $(( ${max} / ${#pad} + 1 )) )
  [[ "${justified}" == "left" ]] && {
    str.stream "${no[@]}" "$@" | echo "$(cat)${full}" | str.take ${max}
  } || {
    str.stream "${no[@]}" "$@" | echo "${full}$(cat)" | str.take -${max}
  }
}

str.base64() {
  # 文字列をbase64エンコード/デコードします
  # input-stream 入力ストリーム
  # opt: d デコード
  # param1+ 対象文字列
  local OPTIND
  local decode=''
  while getopts :d OPT
  do
    case $OPT in
      d) decode='true'
      ;;
    esac
  done
  shift $((OPTIND - 1))

  {
    if [[ "$#" -gt 0 ]];then
      printf '%s' "$*"
    elif [[ ! -t 0 ]];then
      cat -
    fi
  } | if [[ "x${decode}" == "x" ]];then
    base64 | tr '/+' '_-' | tr -d '='
  else
    base64 -d 2>/dev/null
  fi
}

str.hr() (
  # ターミナルに水平線を引きます
  # param1 横幅
  # stdout 水平線
  local width=80
  $(tput cols 2>/dev/null 1>/dev/null) && {
    width=$(tput cols);
  }
  str.times "${1--}" "${width}" | str.take ${width}
)

str.bold() {
  # 入力内容の表示を太字にします
  # param1+ 太字にしたい文字列
  # stdout 太字にした文字列
  echo -e "\033[1m${@}\033[0m"
}
alias str.f.b="str.bold"

str.format.italic() {
  # 入力内容の表示をイタリックにします
  # param1+ イタリックにしたい文字列
  # stdout イタリックにした文字列
  echo -e "\033[3m${@}\033[0m"
}
alias str.f.i="str.format.italic"

str.format.underline() {
  # 入力内容にアンダーラインを引きます
  # param1+ アンダーラインを追加したい文字列
  # stdout アンダーラインを追加した文字列
  echo -e "\033[4m${@}\033[0m"
}
alias str.f.u="str.format.underline"

str.format.strikethrough() {
  # 入力内容に取り消し線を引きます
  # param1+ 取り消し線を追加したい文字列
  # stdout 取り消し線を追加した文字列
  echo -e "\033[9m${@}\033[0m"
}
alias str.f.d="str.format.strikethrough"

